# ==============================================================================
# SECUREMAILSCOPE TESTBED - RENDERED MAIN.CF FOR PCAP-121
# ==============================================================================
# Description: TLS fatal handshake_failure alert
# ==============================================================================

# Hostname & Network Identity
myhostname = mail.test.local
mydomain = test.local
myorigin = $mydomain
mydestination = $myhostname, localhost.$mydomain, localhost
mynetworks = 127.0.0.0/8, 172.28.0.0/16
inet_interfaces = all
inet_protocols = ipv4

# Prevent Reverse DNS lookup delays on Docker network
disable_dns_lookups = yes
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination

# Native container stdout logging
maillog_file = /dev/stdout

# TLS Logging (Level 2 = log TLS cipher suite, protocol, and peer cert details)
smtpd_tls_loglevel = 2
smtpd_tls_received_header = yes
compatibility_level = 3.6

# ------------------------------------------------------------------------------
# TLS Presence & Security Level
# ------------------------------------------------------------------------------
smtpd_tls_security_level = encrypt

# Baseline Server Certificate
smtpd_tls_cert_file = /etc/postfix/baseline_cert.pem
smtpd_tls_key_file = /etc/postfix/baseline_key.pem

# TLS Protocol Restrictions
smtpd_tls_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1, !TLSv1.3, TLSv1.2
smtpd_tls_mandatory_protocols = !SSLv2, !SSLv3, !TLSv1, !TLSv1.1, !TLSv1.3, TLSv1.2

# Cipher Suite Configuration
tls_high_cipherlist = ECDHE-RSA-AES256-GCM-SHA384
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high
